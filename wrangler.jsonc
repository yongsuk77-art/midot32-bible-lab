{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midot32-bible-lab",
  "main": ".worker-dist/worker.mjs",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
